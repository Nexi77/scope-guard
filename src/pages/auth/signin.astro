---
import Layout from "@/layouts/Layout.astro";
import SignInForm from "@/components/auth/SignInForm";

const error = Astro.url.searchParams.get("error");
---

<Layout title="Sign in">
  <main class="flex min-h-screen items-center justify-center bg-secondary/60 p-4 sm:p-6">
    <div class="w-full max-w-sm rounded-xl border bg-card p-6 text-card-foreground shadow-lg sm:p-8">
      <p class="mb-3 text-center text-xs font-semibold tracking-widest text-muted-foreground uppercase">ScopeGuard</p>
      <h1 class="text-center text-3xl font-semibold tracking-tight">Welcome back</h1>
      <p class="mt-2 mb-7 text-center text-sm text-muted-foreground">Sign in to keep every change agreed.</p>
      <SignInForm serverError={error} client:load />
      <p class="mt-6 text-center text-sm text-muted-foreground">
        Don't have an account?{" "}
        <a
          href="/auth/signup"
          class="font-medium text-primary underline-offset-4 hover:underline focus-visible:rounded-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
        >
          Sign up
        </a>
      </p>
    </div>
  </main>
</Layout>
