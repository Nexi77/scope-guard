---
import { AccountMenu } from "@/components/dashboard/AccountMenu";
import ContractorNavigation from "@/components/dashboard/ContractorNavigation.astro";
import ManageOfferPin from "@/components/offers/ManageOfferPin";
import ManageOfferShare from "@/components/offers/ManageOfferShare";
import OfferDetailNav from "@/components/offers/OfferDetailNav.astro";
import Layout from "@/layouts/Layout.astro";
import { loadContractorOfferView } from "@/lib/contractor-offer-view";
import { formatMinorAmount } from "@/lib/offer-items";

const { user } = Astro.locals;
const result = await loadContractorOfferView(Astro.request.headers, Astro.cookies, user, Astro.params.offerId ?? "", {
  items: true,
  currentRevision: true,
  current: true,
  effectiveItems: true,
  templates: true,
  pin: true,
  share: true,
});
Astro.response.headers.set("Cache-Control", "no-store");
const view = result.kind === "ok" ? result.view : null;
const offer = view?.offer ?? null;
if (!view) Astro.response.status = 404;
const isAgreed = offer?.status === "accepted" || offer?.status === "agreed";
const displayItems = isAgreed ? (view?.effectiveItems ?? []) : (view?.items ?? []);
const displayAmount =
  isAgreed && view?.current ? BigInt(view.current.active_amount_minor) : BigInt(offer?.base_amount_minor ?? 0);
const displayDeadline = isAgreed && view?.current ? view.current.active_deadline : (offer?.base_deadline ?? "");
const pendingChangeId = view?.pendingChangeId ?? null;
const showReplacementToast = Astro.url.searchParams.get("notice") === "revision-replaced";
const formatDate = (date: string) =>
  new Intl.DateTimeFormat("en-GB", { dateStyle: "medium", timeZone: "UTC" }).format(new Date(`${date}T00:00:00Z`));
---

<Layout title="Current offer · ScopeGuard">
  <div class="min-h-screen bg-background">
    <header class="border-b bg-background">
      <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6">
        <a
          href="/dashboard"
          class="text-lg font-semibold tracking-tight focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:outline-none"
        >
          ScopeGuard
        </a>
        <AccountMenu client:load email={user?.email ?? "Account"} />
      </div>
    </header>
    <ContractorNavigation current="offers" />
    <main class="mx-auto max-w-4xl px-4 py-8 sm:px-6 sm:py-12">
      <a
        href="/offers"
        class="text-primary text-sm underline underline-offset-4 focus-visible:ring-2 focus-visible:ring-ring focus-visible:outline-none"
      >
        ← Back to offers
      </a>
      {!view || !offer ? (
        <section class="bg-card mt-6 rounded-xl border p-6" aria-labelledby="offer-unavailable-title">
          <h1 id="offer-unavailable-title" class="text-xl font-semibold">
            Offer unavailable
          </h1>
          <p class="text-muted-foreground mt-2">
            This offer could not be loaded. It may not exist or may no longer be accessible.
          </p>
        </section>
      ) : (
        <>
          <div class="mb-5 mt-5 flex flex-wrap items-end justify-between gap-4">
            <div>
              <p class="text-muted-foreground text-sm font-medium">Contractor workspace</p>
              <h1 class="mt-1 text-3xl font-semibold tracking-tight">Current offer</h1>
              <p class="text-muted-foreground mt-2">The latest customer-facing state of this offer.</p>
            </div>
            <span class="bg-secondary rounded-full px-3 py-1 text-sm font-medium capitalize">{offer.status}</span>
          </div>
          <OfferDetailNav
            offerId={offer.id}
            current="overview"
            canEdit={view.canEdit}
            canProposeChange={view.canProposeChange}
          />

          {showReplacementToast ? (
            <p class="border-primary/30 bg-primary/5 mb-6 rounded-md border p-4 text-sm" role="status">
              The pending offer was replaced. Its earlier version remains in history.
            </p>
          ) : null}

          {offer.status === "pending" ? (
            <p class="border-primary/30 bg-primary/5 mb-6 rounded-md border p-4 text-sm" role="status">
              This initial offer is awaiting customer acceptance. The scope and price below are proposed, not agreed
              work.
            </p>
          ) : offer.status === "rejected" ? (
            <section
              class="border-destructive/30 bg-destructive/5 mb-6 rounded-md border p-4"
              aria-labelledby="rejected-offer-title"
            >
              <h2 id="rejected-offer-title" class="font-semibold">
                Customer rejected this offer
              </h2>
              {view.currentRevision?.rejection_comment ? (
                <p class="mt-2 whitespace-pre-wrap text-sm">Reason: {view.currentRevision.rejection_comment}</p>
              ) : (
                <p class="text-muted-foreground mt-2 text-sm">No rejection reason was recorded.</p>
              )}
              <p class="mt-3 text-sm">
                <a
                  class="bg-primary text-primary-foreground focus-visible:ring-ring inline-flex rounded-md px-4 py-2 font-medium focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:outline-none"
                  href={`/offers/new?source=${encodeURIComponent(offer.id)}`}
                >
                  Create new offer from this one
                </a>
              </p>
              <p class="mt-3 text-sm">
                <a class="text-primary underline underline-offset-4" href={`/offers/${offer.id}/history`}>
                  Review the decision
                </a>
                <span aria-hidden="true"> · </span>
                <a class="text-primary underline underline-offset-4" href="/offers">
                  Back to offers
                </a>
              </p>
            </section>
          ) : null}

          {pendingChangeId ? (
            <p class="border-primary/30 bg-secondary mb-6 rounded-md border p-4 text-sm" role="status">
              A proposed change is waiting for customer approval. Its price and deadline are excluded from the current
              values.{" "}
              <a
                class="text-primary font-medium underline underline-offset-4"
                href={`/offers/${offer.id}/history#change-${pendingChangeId}`}
              >
                Review pending change
              </a>
            </p>
          ) : null}

          <section class="bg-card space-y-5 rounded-xl border p-5 sm:p-6" aria-labelledby="current-scope-title">
            <div>
              <h2 id="current-scope-title" class="text-lg font-semibold">
                {isAgreed
                  ? "Current agreed work"
                  : offer.status === "pending"
                    ? "Offer awaiting acceptance"
                    : "Rejected offer"}
              </h2>
              <p class="text-muted-foreground mt-1 text-sm">
                {isAgreed
                  ? "Only accepted and agreed changes affect these values."
                  : "The scope and price presented to the customer."}
              </p>
            </div>
            <dl
              class="grid gap-4 sm:grid-cols-2"
              data-current-amount-minor={displayAmount.toString()}
              data-current-deadline={displayDeadline}
            >
              <div>
                <dt class="text-muted-foreground text-sm">{isAgreed ? "Current total" : "Offer total"}</dt>
                <dd class="mt-1 text-lg font-semibold">{formatMinorAmount(displayAmount)}</dd>
              </div>
              <div>
                <dt class="text-muted-foreground text-sm">{isAgreed ? "Current deadline" : "Proposed deadline"}</dt>
                <dd class="mt-1 font-semibold">{formatDate(displayDeadline)}</dd>
              </div>
            </dl>
            <div>
              <h3 class="text-sm font-medium">Scope description</h3>
              <p class="text-muted-foreground mt-2 whitespace-pre-wrap text-sm">{offer.base_scope}</p>
            </div>
            {isAgreed && (view.current?.active_scope.accepted_changes.length ?? 0) > 0 ? (
              <div>
                <h3 class="text-sm font-medium">Accepted scope changes</h3>
                <ul class="text-muted-foreground mt-2 list-inside list-disc space-y-1 text-sm">
                  {view.current?.active_scope.accepted_changes.map((change) => (
                    <li>{change.description}</li>
                  ))}
                </ul>
              </div>
            ) : null}
            <div class="border-t pt-5">
              <h3 class="mb-3 text-base font-semibold">Priced work items</h3>
              {displayItems.length === 0 ? (
                <p class="text-muted-foreground text-sm">No active items are recorded for this offer.</p>
              ) : (
                <div class="overflow-x-auto">
                  <table class="w-full min-w-[36rem] text-left text-sm">
                    <thead>
                      <tr class="border-b text-muted-foreground">
                        <th scope="col" class="py-2 pr-3 font-medium">
                          Item
                        </th>
                        <th scope="col" class="py-2 pr-3 font-medium">
                          Quantity
                        </th>
                        <th scope="col" class="py-2 pr-3 font-medium">
                          Rate
                        </th>
                        <th scope="col" class="py-2 pr-3 font-medium">
                          Line amount
                        </th>
                        <th scope="col" class="py-2 font-medium">
                          Labor hours/unit (private)
                        </th>
                      </tr>
                    </thead>
                    <tbody class="divide-y">
                      {displayItems.map((item) => (
                        <tr
                          data-offer-item-id={item.id}
                          data-current-item-id={isAgreed ? item.id : undefined}
                          data-line-amount-minor={item.line_amount_minor}
                        >
                          <th scope="row" class="py-3 pr-3 align-top font-medium">
                            {item.name}
                            <p class="text-muted-foreground mt-1 max-w-sm whitespace-pre-wrap font-normal">
                              {item.specification}
                            </p>
                          </th>
                          <td class="py-3 pr-3 align-top">
                            {item.quantity} {item.unit}
                          </td>
                          <td class="py-3 pr-3 align-top">{formatMinorAmount(BigInt(item.selling_rate_minor))}</td>
                          <td class="py-3 pr-3 align-top font-medium">
                            {formatMinorAmount(BigInt(item.line_amount_minor))}
                          </td>
                          <td class="py-3 align-top">{item.labor_hours_per_unit}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              )}
              <div
                class="mt-4 flex justify-end border-t pt-4 text-base font-semibold"
                data-offer-total-minor={displayAmount.toString()}
              >
                Total: {formatMinorAmount(displayAmount)}
              </div>
            </div>
          </section>

          <section class="bg-card mt-6 rounded-xl border p-5 sm:p-6" aria-labelledby="offer-access-title">
            <h2 id="offer-access-title" class="text-lg font-semibold">
              Customer access
            </h2>
            <p class="text-muted-foreground mt-1 text-sm">Manage the six-digit PIN used for customer decisions.</p>
            <ManageOfferPin offerId={offer.id} configured={view.pinConfigured} client:load />
            <h3 class="mt-5 text-base font-semibold">Shared offer link</h3>
            <p class="text-muted-foreground mt-1 text-sm">
              Anyone with this link can view this offer. It does not allow decisions.
            </p>
            <ManageOfferShare
              offerId={offer.id}
              token={offer.share_link_revoked_at ? "" : (offer.share_token ?? "")}
              revoked={offer.share_link_revoked_at !== null && offer.share_link_revoked_at !== undefined}
              origin={Astro.url.origin}
              client:load
            />
          </section>
        </>
      )}
    </main>
  </div>
</Layout>
