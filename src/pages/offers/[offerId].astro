---
import { AccountMenu } from "@/components/dashboard/AccountMenu";
import ContractorNavigation from "@/components/dashboard/ContractorNavigation.astro";
import EditOfferItemsForm from "@/components/offers/EditOfferItemsForm";
import Layout from "@/layouts/Layout.astro";
import { formatMinorAmount, draftFromOfferItem } from "@/lib/offer-items";
import { createClient } from "@/lib/supabase";

interface OfferRecord {
  id: string;
  base_scope: string;
  base_amount_minor: string | number;
  base_deadline: string;
  currency_code: string;
  status: string;
  items_revision: number;
}

interface OfferItemRecord {
  id: string;
  name: string;
  quantity: string | number;
  unit: string;
  specification: string;
  selling_rate_minor: string | number;
  labor_hours_per_unit: string | number;
  line_amount_minor: string | number;
}

const UUID_PATTERN = /^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i;
const { user } = Astro.locals;
const offerId = Astro.params.offerId ?? "";
const supabase = createClient(Astro.request.headers, Astro.cookies);
let offer: OfferRecord | null = null;
let items: OfferItemRecord[] = [];
let hasChanges = false;
let loadError = false;

if (supabase && user && UUID_PATTERN.test(offerId)) {
  const { data, error } = await supabase
    .from("offers")
    .select("id, base_scope, base_amount_minor, base_deadline, currency_code, status, items_revision")
    .eq("id", offerId)
    .eq("contractor_id", user.id)
    .maybeSingle();
  loadError = Boolean(error);
  offer = data;
  if (offer) {
    const [itemsResult, changesResult] = await Promise.all([
      supabase
        .from("offer_items")
        .select("id, name, quantity, unit, specification, selling_rate_minor, labor_hours_per_unit, line_amount_minor")
        .eq("offer_id", offer.id)
        .eq("contractor_id", user.id)
        .order("position", { ascending: true }),
      supabase.from("offer_changes").select("id").eq("offer_id", offer.id).limit(1),
    ]);
    loadError = itemsResult.error !== null || changesResult.error !== null;
    items = itemsResult.data ?? [];
    hasChanges = (changesResult.data?.length ?? 0) > 0;
  }
}

if (!offer || loadError) Astro.response.status = 404;
const canEdit = offer?.status === "pending" && !hasChanges && !loadError;
const baseTotal = offer ? BigInt(offer.base_amount_minor) : 0n;
const formatDate = (date: string) =>
  new Intl.DateTimeFormat("en-GB", { dateStyle: "medium", timeZone: "UTC" }).format(new Date(`${date}T00:00:00Z`));
const lockReason = hasChanges
  ? "The original items are locked because this offer has change history."
  : "The original items can only be edited while the offer is pending.";
---

<Layout title="Offer details · ScopeGuard">
  <div class="min-h-screen bg-background">
    <header class="border-b bg-background">
      <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6">
        <a
          href="/dashboard"
          class="text-lg font-semibold tracking-tight focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:outline-none"
        >
          ScopeGuard
        </a>
        <AccountMenu client:load email={user?.email ?? "Account"} />
      </div>
    </header>
    <ContractorNavigation current="offers" />
    <main class="mx-auto max-w-4xl px-4 py-8 sm:px-6 sm:py-12">
      <a
        href="/offers"
        class="text-primary text-sm underline underline-offset-4 focus-visible:ring-2 focus-visible:ring-ring focus-visible:outline-none"
      >
        ← Back to offers
      </a>
      {!offer || loadError ? (
        <section class="bg-card mt-6 rounded-xl border p-6" aria-labelledby="offer-unavailable-title">
          <h1 id="offer-unavailable-title" class="text-xl font-semibold">
            Offer unavailable
          </h1>
          <p class="text-muted-foreground mt-2">
            This offer could not be loaded. It may not exist or may no longer be accessible.
          </p>
        </section>
      ) : (
        <>
          <div class="mb-7 mt-5 flex flex-wrap items-end justify-between gap-4">
            <div>
              <p class="text-muted-foreground text-sm font-medium">Contractor workspace</p>
              <h1 class="mt-1 text-3xl font-semibold tracking-tight">Offer details</h1>
              <p class="text-muted-foreground mt-2">Review the saved scope and its itemized price.</p>
            </div>
            <span class="bg-secondary rounded-full px-3 py-1 text-sm font-medium capitalize">{offer.status}</span>
          </div>

          <section class="bg-card space-y-5 rounded-xl border p-5 sm:p-6" aria-labelledby="offer-summary-title">
            <h2 id="offer-summary-title" class="text-lg font-semibold">
              Original offer
            </h2>
            <dl class="grid gap-4 sm:grid-cols-2">
              <div>
                <dt class="text-muted-foreground text-sm">Base total</dt>
                <dd class="mt-1 text-lg font-semibold">{formatMinorAmount(baseTotal)}</dd>
              </div>
              <div>
                <dt class="text-muted-foreground text-sm">Deadline</dt>
                <dd class="mt-1 font-semibold">{formatDate(offer.base_deadline)}</dd>
              </div>
            </dl>
            <div>
              <h3 class="text-sm font-medium">Contextual description</h3>
              <p class="text-muted-foreground mt-2 whitespace-pre-wrap text-sm">{offer.base_scope}</p>
            </div>
            <div class="border-t pt-5">
              <h3 class="mb-3 text-base font-semibold">Priced work items</h3>
              <div class="overflow-x-auto">
                <table class="w-full min-w-[36rem] text-left text-sm">
                  <thead>
                    <tr class="border-b text-muted-foreground">
                      <th scope="col" class="py-2 pr-3 font-medium">
                        Item
                      </th>
                      <th scope="col" class="py-2 pr-3 font-medium">
                        Quantity
                      </th>
                      <th scope="col" class="py-2 pr-3 font-medium">
                        Rate
                      </th>
                      <th scope="col" class="py-2 pr-3 font-medium">
                        Line amount
                      </th>
                      <th scope="col" class="py-2 font-medium">
                        Labor hours/unit (private)
                      </th>
                    </tr>
                  </thead>
                  <tbody class="divide-y">
                    {items.map((item) => (
                      <tr data-offer-item-id={item.id} data-line-amount-minor={item.line_amount_minor}>
                        <th scope="row" class="py-3 pr-3 align-top font-medium">
                          {item.name}
                          <p class="text-muted-foreground mt-1 max-w-sm whitespace-pre-wrap font-normal">
                            {item.specification}
                          </p>
                        </th>
                        <td class="py-3 pr-3 align-top">
                          {item.quantity} {item.unit}
                        </td>
                        <td class="py-3 pr-3 align-top">{formatMinorAmount(BigInt(item.selling_rate_minor))}</td>
                        <td class="py-3 pr-3 align-top font-medium">
                          {formatMinorAmount(BigInt(item.line_amount_minor))}
                        </td>
                        <td class="py-3 align-top">{item.labor_hours_per_unit}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
              <div
                class="mt-4 flex justify-end border-t pt-4 text-base font-semibold"
                data-offer-total-minor={baseTotal.toString()}
              >
                Total: {formatMinorAmount(baseTotal)}
              </div>
            </div>
          </section>

          <section class="bg-card mt-6 rounded-xl border p-5 sm:p-6" aria-labelledby="item-corrections-title">
            <h2 id="item-corrections-title" class="mb-4 text-lg font-semibold">
              Original item corrections
            </h2>
            {canEdit ? (
              <EditOfferItemsForm
                client:load
                offerId={offer.id}
                revision={offer.items_revision}
                initialItems={items.map(draftFromOfferItem)}
              />
            ) : (
              <p class="text-muted-foreground rounded-md bg-secondary px-4 py-3 text-sm" role="status">
                {lockReason}
              </p>
            )}
          </section>
        </>
      )}
    </main>
  </div>
</Layout>
