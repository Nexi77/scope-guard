---
import { AccountMenu } from "@/components/dashboard/AccountMenu";
import ContractorNavigation from "@/components/dashboard/ContractorNavigation.astro";
import OfferDetailNav from "@/components/offers/OfferDetailNav.astro";
import ReplacePendingOfferForm from "@/components/offers/ReplacePendingOfferForm";
import Layout from "@/layouts/Layout.astro";
import { loadContractorOfferView } from "@/lib/contractor-offer-view";
import { draftFromOfferItem } from "@/lib/offer-items";

const { user } = Astro.locals;
const result = await loadContractorOfferView(Astro.request.headers, Astro.cookies, user, Astro.params.offerId ?? "", {
  items: true,
});
const view = result.kind === "ok" ? result.view : null;
const canEdit = view?.canEdit === true;
if (!canEdit) Astro.response.status = 404;
const offer = canEdit ? view.offer : null;
const currentOfferHref = `/offers/${encodeURIComponent(Astro.params.offerId ?? "")}`;
const showSuccessToast = Astro.url.searchParams.get("notice") === "revision-replaced";
---

<Layout title="Edit pending offer · ScopeGuard">
  <div class="min-h-screen bg-background">
    <header class="border-b bg-background">
      <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6">
        <a
          href="/dashboard"
          class="text-lg font-semibold tracking-tight focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:outline-none"
        >
          ScopeGuard
        </a>
        <AccountMenu client:load email={user?.email ?? "Account"} />
      </div>
    </header>
    <ContractorNavigation current="offers" />
    <main class="mx-auto max-w-4xl px-4 py-8 sm:px-6 sm:py-12">
      <a class="text-primary text-sm underline underline-offset-4" href={currentOfferHref}>
        ← Back to current offer
      </a>
      {!view || !offer ? (
        <section class="bg-card mt-6 rounded-xl border p-6" aria-labelledby="task-unavailable-title">
          <h1 id="task-unavailable-title" class="text-xl font-semibold">
            Offer editing unavailable
          </h1>
          <p class="text-muted-foreground mt-2">This offer cannot be edited or is no longer accessible.</p>
        </section>
      ) : (
        <>
          <div class="mb-5 mt-5">
            <p class="text-muted-foreground text-sm font-medium">Contractor workspace</p>
            <h1 class="mt-1 text-3xl font-semibold tracking-tight">Edit pending offer</h1>
            <p class="text-muted-foreground mt-2">Correct scope, deadline, and priced items in one replacement.</p>
          </div>
          <OfferDetailNav offerId={offer.id} current="overview" canEdit />
          <section class="bg-card space-y-4 rounded-xl border p-5 sm:p-6" aria-labelledby="edit-pending-title">
            <h2 id="edit-pending-title" class="text-lg font-semibold">
              Replace the pending version
            </h2>
            <ReplacePendingOfferForm
              client:load
              offerId={offer.id}
              revision={offer.base_revision}
              initialScope={offer.base_scope}
              initialDeadline={offer.base_deadline}
              initialItems={view.items.map(draftFromOfferItem)}
              showSuccessToast={showSuccessToast}
            />
          </section>
        </>
      )}
    </main>
  </div>
</Layout>
