---
import { AccountMenu } from "@/components/dashboard/AccountMenu";
import ContractorNavigation from "@/components/dashboard/ContractorNavigation.astro";
import ManageOfferPin from "@/components/offers/ManageOfferPin";
import Layout from "@/layouts/Layout.astro";
import { createClient } from "@/lib/supabase";

const CUSTOMER_PAGE_SIZE = 25;
const OFFER_PAGE_SIZE = 25;
const UUID_PATTERN = /^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i;

interface OfferSummary {
  offer_id: string;
  original_scope: string;
  status: string;
  currency_code: string;
  current_amount_minor: string;
  current_deadline: string;
  created_at: string;
  pin_configured?: boolean;
}

const { user } = Astro.locals;
const supabase = createClient(Astro.request.headers, Astro.cookies);
const params = Astro.url.searchParams;
const query = (params.get("q") ?? "").trim().slice(0, 100);
const pageValue = Number(params.get("page") ?? "0");
const customerPage = Number.isSafeInteger(pageValue) && pageValue >= 0 ? pageValue : 0;
const customerId = params.get("customer") ?? "";
const offerBeforeCreatedAt = params.get("before") ?? "";
const offerBeforeId = params.get("beforeId") ?? "";
const validCustomerId = UUID_PATTERN.test(customerId);

let customers: { id: string; name: string }[] = [];
let customersError = false;
let hasNextCustomerPage = false;
let selectedCustomer: { id: string; name: string } | null = null;
let selectedCustomerError = false;
let offers: OfferSummary[] = [];
let offersError = false;
let hasNextOfferPage = false;

if (supabase && user) {
  const from = customerPage * CUSTOMER_PAGE_SIZE;
  const { data, error } = await supabase
    .from("customers")
    .select("id, name")
    .ilike("name", `%${query.replace(/[\\%_]/g, "\\$&")}%`)
    .order("name", { ascending: true })
    .order("id", { ascending: true })
    .range(from, from + CUSTOMER_PAGE_SIZE);
  customersError = Boolean(error);
  customers = (data ?? []).slice(0, CUSTOMER_PAGE_SIZE);
  hasNextCustomerPage = (data?.length ?? 0) > CUSTOMER_PAGE_SIZE;

  if (customerId) {
    if (!validCustomerId) {
      selectedCustomerError = true;
    } else {
      const { data: customer, error: customerError } = await supabase
        .from("customers")
        .select("id, name")
        .eq("id", customerId)
        .maybeSingle();
      selectedCustomerError = Boolean(customerError);
      selectedCustomer = customer;
      if (selectedCustomer) {
        const cursorValid = /^\d{4}-\d{2}-\d{2}T/.test(offerBeforeCreatedAt) && UUID_PATTERN.test(offerBeforeId);
        const { data: offerData, error: offerError } = await supabase
          .rpc("list_customer_offers", {
            p_customer_id: selectedCustomer.id,
            p_limit: OFFER_PAGE_SIZE + 1,
            p_before_created_at: cursorValid ? offerBeforeCreatedAt : null,
            p_before_id: cursorValid ? offerBeforeId : null,
          })
          .overrideTypes<OfferSummary[], { merge: false }>();
        offersError = Boolean(offerError);
        const offerRows = Array.isArray(offerData) ? offerData : [];
        offers = offerRows.slice(0, OFFER_PAGE_SIZE);
        hasNextOfferPage = offerRows.length > OFFER_PAGE_SIZE;
        if (offers.length > 0) {
          const { data: pinRows, error: pinError } = await supabase
            .from("offers")
            .select("id, pin_hash")
            .eq("contractor_id", user.id)
            .in(
              "id",
              offers.map((offer) => offer.offer_id),
            );
          if (pinError) offersError = true;
          const configuredById = new Map((pinRows ?? []).map((offer) => [offer.id, offer.pin_hash !== null]));
          offers = offers.map((offer) => ({ ...offer, pin_configured: configuredById.get(offer.offer_id) ?? false }));
        }
      }
    }
  }
}

const customerPageHref = (page: number) => {
  const next = new URLSearchParams();
  if (query) next.set("q", query);
  next.set("page", String(page));
  return `/offers?${next.toString()}`;
};
const formatPrice = (minorText: string) => {
  try {
    const minor = BigInt(minorText);
    const major = minor / 100n;
    const fraction = (minor % 100n).toString().padStart(2, "0");
    return `${new Intl.NumberFormat("pl-PL").format(major)},${fraction} zł`;
  } catch {
    return "Unavailable";
  }
};
const dateOnly = (value: string) => value.slice(0, 10);
const scopeExcerpt = (scope: string) => {
  const normalized = scope.replace(/\s+/g, " ").trim();
  return normalized.length > 160 ? `${normalized.slice(0, 157).trimEnd()}…` : normalized;
};
const nextOfferHref = (() => {
  const last = offers.at(-1);
  if (!last || !selectedCustomer) return "#";
  const next = new URLSearchParams({ customer: selectedCustomer.id, before: last.created_at, beforeId: last.offer_id });
  if (query) next.set("q", query);
  return `/offers?${next.toString()}`;
})();
---

<Layout title="Offers · ScopeGuard">
  <div class="min-h-screen bg-background">
    <header class="border-b bg-background">
      <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6">
        <a
          href="/dashboard"
          class="text-lg font-semibold tracking-tight focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:outline-none"
        >
          ScopeGuard
        </a>
        <AccountMenu client:load email={user?.email ?? "Account"} />
      </div>
    </header>
    <ContractorNavigation current="offers" />
    <main class="mx-auto max-w-6xl px-4 py-8 sm:px-6 sm:py-12" aria-busy="false">
      <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="text-muted-foreground text-sm font-medium">Contractor workspace</p>
          <h1 class="mt-1 text-3xl font-semibold tracking-tight">Offers</h1>
          <p class="text-muted-foreground mt-2">Browse customers and review their recorded offers.</p>
        </div>
        <a
          href="/offers/new"
          class="bg-primary text-primary-foreground inline-flex h-10 items-center rounded-md px-4 text-sm font-medium focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:outline-none"
        >
          Create offer
        </a>
      </div>

      <form method="GET" action="/offers" class="mb-6 flex max-w-xl gap-2">
        <label for="customer-search" class="sr-only">
          Find customer by name
        </label>
        <input
          id="customer-search"
          name="q"
          value={query}
          placeholder="Find customer by name"
          class="border-input bg-background placeholder:text-muted-foreground focus-visible:ring-ring h-10 min-w-0 flex-1 rounded-md border px-3 text-sm focus-visible:ring-2 focus-visible:outline-none"
        />
        <button
          class="border-input bg-background inline-flex h-10 items-center rounded-md border px-4 text-sm font-medium focus-visible:ring-2 focus-visible:ring-ring focus-visible:outline-none"
          type="submit"
        >
          Search
        </button>
      </form>

      {!supabase || !user ? (
        <p class="border-destructive/30 bg-destructive/10 text-destructive rounded-md border p-4" role="alert">
          Your session has expired. Sign in again to view offers.
        </p>
      ) : customersError ? (
        <p class="border-destructive/30 bg-destructive/10 text-destructive rounded-md border p-4" role="alert">
          Customers could not be loaded. Refresh the page and try again.
        </p>
      ) : customers.length === 0 ? (
        <section class="bg-card rounded-xl border p-6" aria-live="polite">
          <h2 class="text-lg font-semibold">{query ? "No matching customers" : "No customers yet"}</h2>
          <p class="text-muted-foreground mt-2">
            {query ? "Try another name or clear your search." : "Create an offer to add your first customer."}
          </p>
          {!query ? (
            <a href="/offers/new" class="text-primary mt-4 inline-flex underline underline-offset-4">
              Create an offer
            </a>
          ) : null}
        </section>
      ) : (
        <div class="grid items-start gap-8 lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)]">
          <section aria-labelledby="customer-list-title">
            <h2 id="customer-list-title" class="mb-3 text-lg font-semibold">
              Customers
            </h2>
            <ul class="divide-border bg-card divide-y overflow-hidden rounded-xl border">
              {customers.map((customer) => (
                <li>
                  <a
                    href={`/offers?${new URLSearchParams({ ...(query ? { q: query } : {}), customer: customer.id }).toString()}`}
                    aria-current={selectedCustomer?.id === customer.id ? "true" : undefined}
                    class:list={[
                      "flex min-h-14 items-center justify-start gap-3 px-4 py-3 text-sm focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-ring focus-visible:outline-none",
                      selectedCustomer?.id === customer.id ? "bg-secondary font-medium" : "hover:bg-secondary/60",
                    ]}
                  >
                    <span>{customer.name}</span>
                  </a>
                </li>
              ))}
            </ul>
            <div class="mt-4 flex items-center justify-between gap-3">
              {customerPage > 0 ? (
                <a class="text-primary text-sm underline underline-offset-4" href={customerPageHref(customerPage - 1)}>
                  Previous customers
                </a>
              ) : (
                <span />
              )}
              {hasNextCustomerPage ? (
                <a class="text-primary text-sm underline underline-offset-4" href={customerPageHref(customerPage + 1)}>
                  Next customers
                </a>
              ) : null}
            </div>
          </section>

          <section aria-labelledby="offer-list-title" aria-live="polite">
            {!customerId ? (
              <div class="bg-card rounded-xl border p-6">
                <h2 class="text-lg font-semibold">Select a customer</h2>
                <p class="text-muted-foreground mt-2">Choose a customer to load their offers.</p>
              </div>
            ) : selectedCustomerError ? (
              <p class="border-destructive/30 bg-destructive/10 text-destructive rounded-md border p-4" role="alert">
                This customer could not be loaded. Refresh the page or select a customer from the list.
              </p>
            ) : !selectedCustomer ? (
              <div class="bg-card rounded-xl border p-6">
                <h2 class="text-lg font-semibold">Customer unavailable</h2>
                <p class="text-muted-foreground mt-2">
                  This customer is unavailable. They may not exist or may no longer be accessible.
                </p>
              </div>
            ) : offersError ? (
              <p class="border-destructive/30 bg-destructive/10 text-destructive rounded-md border p-4" role="alert">
                Offers could not be loaded. Refresh the page and try again.
              </p>
            ) : (
              <>
                <h2 id="offer-list-title" class="mb-3 text-lg font-semibold">
                  Offers for {selectedCustomer.name}
                </h2>
                {offers.length === 0 ? (
                  <div class="bg-card rounded-xl border p-6">
                    <p class="text-muted-foreground">No offers for this customer yet.</p>
                  </div>
                ) : (
                  <ul class="space-y-3">
                    {offers.map((offer) => (
                      <li class="bg-card rounded-xl border p-4 sm:p-5">
                        <div class="flex flex-wrap items-start justify-between gap-3">
                          <div class="min-w-0 flex-1">
                            <p class="line-clamp-2 font-medium">{scopeExcerpt(offer.original_scope)}</p>
                            <p class="text-muted-foreground mt-2 text-sm">Created {dateOnly(offer.created_at)}</p>
                          </div>
                          <span class="bg-secondary rounded-full px-3 py-1 text-xs font-medium capitalize">
                            {offer.status}
                          </span>
                        </div>
                        <dl class="mt-4 grid grid-cols-2 gap-3 text-sm">
                          <div>
                            <dt class="text-muted-foreground">Current price</dt>
                            <dd class="mt-1 font-semibold">{formatPrice(offer.current_amount_minor)}</dd>
                          </div>
                          <div>
                            <dt class="text-muted-foreground">Current deadline</dt>
                            <dd class="mt-1 font-semibold">{dateOnly(offer.current_deadline)}</dd>
                          </div>
                        </dl>
                        <a
                          href={`/offers/${encodeURIComponent(offer.offer_id)}`}
                          class="text-primary mt-4 inline-flex min-h-9 items-center font-medium underline underline-offset-4 focus-visible:ring-2 focus-visible:ring-ring focus-visible:outline-none"
                        >
                          Review offer
                        </a>
                        <div data-offer-id={offer.offer_id}>
                          <ManageOfferPin
                            offerId={offer.offer_id}
                            configured={offer.pin_configured ?? false}
                            client:load
                          />
                        </div>
                      </li>
                    ))}
                  </ul>
                )}
                {hasNextOfferPage ? (
                  <a
                    class="text-primary mt-5 inline-flex text-sm font-medium underline underline-offset-4 focus-visible:ring-2 focus-visible:ring-ring focus-visible:outline-none"
                    href={nextOfferHref}
                  >
                    Next offers
                  </a>
                ) : null}
              </>
            )}
          </section>
        </div>
      )}
    </main>
  </div>
</Layout>
