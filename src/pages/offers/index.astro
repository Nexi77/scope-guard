---
import { AccountMenu } from "@/components/dashboard/AccountMenu";
import ContractorNavigation from "@/components/dashboard/ContractorNavigation.astro";
import OfferBrowseTable from "@/components/offers/OfferBrowseTable.astro";
import Layout from "@/layouts/Layout.astro";
import { createClient } from "@/lib/supabase";

const CUSTOMER_PAGE_SIZE = 25;
const OFFER_PAGE_SIZE = 25;
const UUID_PATTERN = /^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i;

interface OfferSummary {
  offer_id: string;
  original_scope: string;
  status: string;
  currency_code: string;
  current_amount_minor: string;
  current_deadline: string;
  created_at: string;
}

interface CustomerSummary {
  customer_id: string;
  name: string;
  offer_count: number;
  last_activity: string | null;
  total_customers: number;
  page: number;
}

interface OfferPage {
  offer_id: string;
  original_scope: string;
  status: string;
  currency_code: string;
  current_amount_minor: string;
  current_deadline: string;
  created_at: string;
  total_offers: number;
  page: number;
}

const { user } = Astro.locals;
const supabase = createClient(Astro.request.headers, Astro.cookies);
const params = Astro.url.searchParams;
const query = (params.get("q") ?? "").trim().slice(0, 100);
const customerPageValue = Number(params.get("page") ?? "1");
let customerPage = Number.isSafeInteger(customerPageValue) && customerPageValue >= 1 ? customerPageValue : 1;
const customerId = params.get("customer") ?? "";
const offerPageValue = Number(params.get("offerPage") ?? "1");
let offerPage = Number.isSafeInteger(offerPageValue) && offerPageValue >= 1 ? offerPageValue : 1;
const validCustomerId = UUID_PATTERN.test(customerId);

let customers: CustomerSummary[] = [];
let customersError = false;
let totalCustomers = 0;
let selectedCustomer: { id: string; name: string } | null = null;
let selectedCustomerError = false;
let offers: OfferSummary[] = [];
let offersError = false;
let totalOffers = 0;
let offerIdsWithHistory = new Set<string>();

if (supabase && user) {
  const { data: customerRows, error: customerRowsError } = await supabase
    .rpc("list_contractor_customers", {
      p_query: query,
      p_page: customerPage,
      p_page_size: CUSTOMER_PAGE_SIZE,
    })
    .overrideTypes<CustomerSummary[], { merge: false }>();
  customersError = Boolean(customerRowsError);
  customers = Array.isArray(customerRows) ? customerRows : [];
  totalCustomers = customers[0]?.total_customers ?? 0;
  customerPage = customers[0]?.page ?? 1;

  if (customerId) {
    if (!validCustomerId) {
      selectedCustomerError = true;
    } else {
      const { data: customer, error: customerError } = await supabase
        .from("customers")
        .select("id, name")
        .eq("id", customerId)
        .eq("contractor_id", user.id)
        .maybeSingle();
      selectedCustomerError = Boolean(customerError);
      selectedCustomer = customer;
      if (selectedCustomer) {
        const { data: offerData, error: offerError } = await supabase
          .rpc("list_contractor_customer_offer_page", {
            p_customer_id: selectedCustomer.id,
            p_page: offerPage,
            p_page_size: OFFER_PAGE_SIZE,
          })
          .overrideTypes<OfferPage[], { merge: false }>();
        offersError = Boolean(offerError);
        const offerRows = Array.isArray(offerData) ? offerData : [];
        offers = offerRows;
        totalOffers = offerRows[0]?.total_offers ?? 0;
        offerPage = offerRows[0]?.page ?? 1;
        if (!offersError && offers.length > 0) {
          const { data: changeRows, error: changesError } = await supabase
            .from("offer_changes")
            .select("offer_id")
            .eq("contractor_id", user.id)
            .in(
              "offer_id",
              offers.map((offer) => offer.offer_id),
            )
            .overrideTypes<{ offer_id: string }[], { merge: false }>();
          offersError = Boolean(changesError);
          offerIdsWithHistory = new Set((changeRows ?? []).map((change) => change.offer_id));
        }
      }
    }
  }
}

const customerPageHref = (page: number) => {
  const next = new URLSearchParams();
  if (query) next.set("q", query);
  next.set("page", String(page));
  return `/offers?${next.toString()}`;
};
const offerPageHref = (page: number) => {
  if (!selectedCustomer) return "/offers";
  const next = new URLSearchParams({ customer: selectedCustomer.id, offerPage: String(page) });
  if (query) next.set("q", query);
  if (customerPage > 1) next.set("page", String(customerPage));
  return `/offers?${next.toString()}#offer-list-title`;
};
const customerPageCount = Math.max(1, Math.ceil(totalCustomers / CUSTOMER_PAGE_SIZE));
const offerPageCount = Math.max(1, Math.ceil(totalOffers / OFFER_PAGE_SIZE));
const customerRangeSummary =
  totalCustomers === 0
    ? "No customers yet"
    : `Showing ${(customerPage - 1) * CUSTOMER_PAGE_SIZE + 1}–${Math.min(customerPage * CUSTOMER_PAGE_SIZE, totalCustomers)} of ${totalCustomers} customers`;
const offerRangeSummary =
  totalOffers === 0
    ? "No offers yet"
    : `Showing ${(offerPage - 1) * OFFER_PAGE_SIZE + 1}–${Math.min(offerPage * OFFER_PAGE_SIZE, totalOffers)} of ${totalOffers} offers`;
const formatPrice = (minorText: string) => {
  try {
    const minor = BigInt(minorText);
    const major = minor / 100n;
    const fraction = (minor % 100n).toString().padStart(2, "0");
    return `${new Intl.NumberFormat("pl-PL").format(major)},${fraction} zł`;
  } catch {
    return "Unavailable";
  }
};
const dateOnly = (value: string | null) => (value ? value.slice(0, 10) : "No activity yet");
const scopeExcerpt = (scope: string) => {
  const normalized = scope.replace(/\s+/g, " ").trim();
  return normalized.length > 160 ? `${normalized.slice(0, 157).trimEnd()}…` : normalized;
};
---

<Layout title="Offers · ScopeGuard">
  <div class="min-h-screen bg-background">
    <header class="border-b bg-background">
      <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6">
        <a
          href="/dashboard"
          class="text-lg font-semibold tracking-tight focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:outline-none"
        >
          ScopeGuard
        </a>
        <AccountMenu client:load email={user?.email ?? "Account"} />
      </div>
    </header>
    <ContractorNavigation current="offers" />
    <main class="mx-auto max-w-6xl px-4 py-8 sm:px-6 sm:py-12" aria-busy="false">
      <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="text-muted-foreground text-sm font-medium">Contractor workspace</p>
          <h1 class="mt-1 text-3xl font-semibold tracking-tight">Offers</h1>
          <p class="text-muted-foreground mt-2">Browse customers and review their recorded offers.</p>
        </div>
        <a
          href="/offers/new"
          class="bg-primary text-primary-foreground hover:bg-primary/90 focus-visible:ring-ring inline-flex h-10 items-center rounded-md px-4 text-sm font-medium focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:outline-none"
        >
          Create offer
        </a>
      </div>

      <form method="GET" action="/offers" class="mb-6 flex max-w-xl gap-2" data-offer-browse-form>
        <label for="customer-search" class="sr-only">
          Find customer by name
        </label>
        <input
          id="customer-search"
          name="q"
          value={query}
          placeholder="Find customer by name"
          class="border-input bg-background placeholder:text-muted-foreground focus-visible:ring-ring h-10 min-w-0 flex-1 rounded-md border px-3 text-sm focus-visible:ring-2 focus-visible:outline-none"
        />
        <button
          class="border-input bg-background hover:bg-accent focus-visible:ring-ring inline-flex h-10 items-center rounded-md border px-4 text-sm font-medium focus-visible:ring-2 focus-visible:outline-none"
          type="submit"
        >
          Search
        </button>
      </form>

      {!supabase || !user ? (
        <p class="border-destructive/30 bg-destructive/10 text-destructive rounded-md border p-4" role="alert">
          Your session has expired. Sign in again to view offers.
        </p>
      ) : customersError ? (
        <p class="border-destructive/30 bg-destructive/10 text-destructive rounded-md border p-4" role="alert">
          Customers could not be loaded. Refresh the page and try again.
        </p>
      ) : customers.length === 0 ? (
        <section class="bg-card rounded-xl border p-6" aria-live="polite">
          <h2 class="text-lg font-semibold">{query ? "No matching customers" : "No customers yet"}</h2>
          <p class="text-muted-foreground mt-2">
            {query ? "Try another name or clear your search." : "Create an offer to add your first customer."}
          </p>
          {!query ? (
            <a href="/offers/new" class="text-primary mt-4 inline-flex underline underline-offset-4">
              Create an offer
            </a>
          ) : null}
        </section>
      ) : (
        <OfferBrowseTable
          customers={customers}
          offers={offers}
          selectedCustomer={selectedCustomer}
          customerId={customerId}
          selectedCustomerError={selectedCustomerError}
          offersError={offersError}
          offerIdsWithHistory={offerIdsWithHistory}
          query={query}
          customerPage={customerPage}
          customerPageCount={customerPageCount}
          customerRangeSummary={customerRangeSummary}
          offerPage={offerPage}
          offerPageCount={offerPageCount}
          offerRangeSummary={offerRangeSummary}
          customerPageHref={customerPageHref}
          offerPageHref={offerPageHref}
          formatPrice={formatPrice}
          dateOnly={dateOnly}
          scopeExcerpt={scopeExcerpt}
        />
      )}
    </main>
  </div>
</Layout>

<style>
  :global(html) {
    scroll-behavior: smooth;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html) {
      scroll-behavior: auto;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLFormElement>("[data-offer-browse-form]").forEach((form) => {
    form.addEventListener("submit", () => {
      document.querySelector("main")?.setAttribute("aria-busy", "true");
      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      if (button) {
        button.setAttribute("aria-disabled", "true");
        button.textContent = "Loading…";
      }
    });
  });
</script>
