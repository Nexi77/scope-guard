---
import "../styles/global.css";

interface Props {
  title?: string;
}

const { title = "ScopeGuard" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>{title}</title>
    <script is:inline>
      const savedTheme = localStorage.getItem("scopeguard-theme");
      document.documentElement.classList.toggle("dark", savedTheme === "dark");
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
