---
import OfferActionsMenu from "@/components/offers/OfferActionsMenu";

interface Props {
  offerId: string;
  current: "overview" | "history";
  canEdit?: boolean;
  canProposeChange?: boolean;
}

const { offerId, current, canEdit = false, canProposeChange = false } = Astro.props;
const base = `/offers/${encodeURIComponent(offerId)}`;
const links = [
  { label: "Current state", href: base, key: "overview" },
  { label: "History", href: `${base}/history`, key: "history" },
] as const;
---

<nav aria-label="Offer details" class="border-border mb-7 flex items-center justify-between gap-3 border-b">
  <div class="flex min-w-0 gap-1">
    {links.map((link) => (
      <a
        href={link.href}
        aria-current={current === link.key ? "page" : undefined}
        class:list={[
          "focus-visible:ring-ring inline-flex min-h-11 items-center border-b-2 px-4 text-sm font-medium focus-visible:ring-2 focus-visible:outline-none",
          current === link.key
            ? "border-primary text-foreground"
            : "text-muted-foreground hover:text-foreground border-transparent hover:border-border",
        ]}
      >
        {link.label}
      </a>
    ))}
  </div>
  <OfferActionsMenu offerId={offerId} canEdit={canEdit} canProposeChange={canProposeChange} client:load />
</nav>
