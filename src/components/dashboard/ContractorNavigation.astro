---
interface Props {
  current: "dashboard" | "offers" | "new-offer";
}

const { current } = Astro.props;
const links = [
  { href: "/dashboard", label: "Dashboard", key: "dashboard" },
  { href: "/offers", label: "Offers", key: "offers" },
  { href: "/offers/new", label: "Create offer", key: "new-offer" },
] as const;
---

<nav aria-label="Contractor navigation" class="border-b bg-background">
  <ul class="mx-auto flex max-w-6xl gap-2 overflow-x-auto px-4 sm:px-6">
    {links.map(({ href, label, key }) => (
      <li>
        <a
          href={href}
          aria-current={current === key ? "page" : undefined}
          class:list={[
            "inline-flex min-h-12 items-center border-b-2 px-3 text-sm font-medium transition-colors focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:outline-none",
            current === key
              ? "border-primary text-foreground"
              : "text-muted-foreground border-transparent hover:text-foreground hover:border-border",
          ]}
        >
          {label}
          {current === key ? <span class="sr-only"> (current page)</span> : null}
        </a>
      </li>
    ))}
  </ul>
</nav>
